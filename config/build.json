{
  "$schema": "./schemas/build.schema.json",
  "project": "XboxOS11",
  "version": "0.1.1",
  "description": "Gaming-focused Windows 11 image customization for Xbox Full Screen Experience",
  "target": {
    "windowsVersion": "11",
    "release": "unverified",
    "releaseNotes": "Do not assume 25H2 from ISO filenames such as 26300.9457. Set release only from verified image metadata (DisplayVersion / build) after inventory.",
    "edition": "Windows 11 Pro",
    "architecture": "amd64",
    "imageNamePattern": "*Pro*",
    "sourceImageIndex": 6,
    "minimumBuild": 26100,
    "bootFirmware": "UEFI",
    "partitionStyle": "GPT"
  },
  "hardwareProfile": {
    "cpu": "AMD Ryzen 7 7800X3D",
    "gpu": "AMD Radeon RX 9070 XT",
    "notes": "Chipset and Radeon Adrenalin software should be installed after Windows Setup; do not inject the full Adrenalin installer into the offline image."
  },
  "workspace": {
    "root": "C:\\XboxOS\\Work",
    "cache": "C:\\XboxOS\\Work\\cache",
    "logs": "C:\\XboxOS\\Logs",
    "temp": "C:\\XboxOS\\Work\\temp",
    "output": "C:\\XboxOS\\Output",
    "minimumFreeGb": 40
  },
  "source": {
    "preserveOriginal": true,
    "hashAlgorithm": "SHA256",
    "preferredImageFormat": "wim"
  },
  "iso": {
    "label": "XboxOS11",
    "fileNameTemplate": "XboxOS11-Win11Pro-{releaseTag}.iso",
    "fileName": null,
    "unverifiedReleaseFallback": "buildunknown",
    "uefiBoot": true,
    "splitWimThresholdBytes": 4294967295,
    "bootData": "-bootdata:2#p0,e,b{boot}\\etfsboot.com#pEF,e,b{efi}\\efisys.bin"
  },
  "phases": {
    "importSource": true,
    "inventoryBefore": true,
    "removeApps": true,
    "disableFeatures": true,
    "addDrivers": true,
    "addUpdates": true,
    "inventoryAfter": true,
    "validate": true,
    "exportIso": true,
    "removeCapabilities": false,
    "imageTweaks": false,
    "componentCleanup": false,
    "recompress": false
  },
  "image": {
    "resetBase": false,
    "compression": "Default",
    "notes": "Lean-image options. compression: Default keeps the export compression, Max writes install.wim, Recovery writes a smaller install.esd. resetBase makes updates already in the image permanent."
  },
  "paths": {
    "removeAppsManifest": "./config/remove-apps.json",
    "disableFeaturesManifest": "./config/disable-features.json",
    "servicesManifest": "./config/services.json",
    "driversManifest": "./config/drivers.json",
    "compatibilityManifest": "./config/compatibility.json",
    "removeCapabilitiesManifest": "./config/remove-capabilities.json",
    "imageTweaksManifest": "./config/image-tweaks.json",
    "driverDirectory": "C:\\XboxOS\\Drivers",
    "updateDirectory": "C:\\XboxOS\\Updates"
  },
  "safety": {
    "requireAdministrator": true,
    "allowHostModification": false,
    "commitOnFailure": false,
    "dryRunDefault": false,
    "rejectAmbiguousPackageMatches": true,
    "neverRemoveProtectedPackages": true,
    "rejectCloudSynchronizedBuildPaths": true,
    "rejectRepositoryBuildPaths": true
  },
  "logging": {
    "level": "Information",
    "structuredJson": true,
    "retainDays": 14
  }
}
