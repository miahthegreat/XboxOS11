{
  "schemaVersion": "xboxos-builder-preset-v1",
  "id": "gaming-lean",
  "order": 2,
  "displayName": "Gaming - Lean",
  "recommended": false,
  "description": "Balanced plus removal of Get Help and Tips and the fax client. Still preserves Store, Xbox, Gaming Services, Defender, and Update.",
  "profile": {
    "source": {
      "isoPath": "",
      "editionPattern": "*Pro*",
      "imageIndex": null
    },
    "apps": {
      "remove": [
        "Clipchamp",
        "Copilot",
        "TeamsConsumer",
        "News",
        "Weather",
        "Solitaire",
        "OutlookConsumer",
        "GetHelp",
        "Tips"
      ]
    },
    "features": {
      "disable": [
        "XpsViewer",
        "PrintingXPS",
        "Smb1",
        "WorkFolders",
        "FaxAndScan"
      ]
    },
    "drivers": {
      "enabled": false,
      "directory": "C:\\XboxOS\\Drivers"
    },
    "updates": {
      "enabled": false,
      "directory": "C:\\XboxOS\\Updates"
    },
    "setup": {
      "unattend": true,
      "uiLanguage": "en-US",
      "inputLocale": "en-US",
      "systemLocale": "en-US",
      "userLocale": "en-US",
      "timeZone": "Pacific Standard Time",
      "hideEula": true,
      "privacy": "Minimal",
      "startupToGamingHome": false,
      "postInstall": {
        "enabled": true,
        "gameMode": true,
        "hardwareAcceleratedGpuScheduling": false,
        "launchers": [],
        "optimizations": [
          "WindowedGameOptimizations",
          "BackgroundRecordingOff"
        ]
      }
    },
    "output": {
      "directory": "C:\\XboxOS\\Output",
      "isoLabel": "XboxOS11"
    }
  }
}
