{
  "schemaVersion": "xboxos-builder-preset-v1",
  "id": "gaming-tiny",
  "order": 3,
  "displayName": "Gaming - Tiny (smallest serviceable image)",
  "recommended": false,
  "description": "Tiny11-class: removes every non-gaming inbox app and optional capability, blocks sponsored apps and ads, skips OneDrive for new accounts, cleans the component store, and compresses to install.esd. Keeps Store, Xbox, Gaming Services, Edge/WebView2, Defender, Windows Update, and recovery.",
  "profile": {
    "source": {
      "isoPath": "",
      "editionPattern": "*Pro*",
      "imageIndex": null
    },
    "apps": {
      "remove": [
        "Clipchamp",
        "Copilot",
        "TeamsConsumer",
        "News",
        "Weather",
        "Solitaire",
        "OutlookConsumer",
        "GetHelp",
        "Tips",
        "BingSearch",
        "PowerAutomate",
        "ToDo",
        "DevHome",
        "Clock",
        "FeedbackHub",
        "SoundRecorder",
        "PhoneLink",
        "MediaPlayer",
        "MoviesTV",
        "QuickAssist",
        "MailCalendar",
        "Maps",
        "People",
        "Cortana",
        "FamilySafety",
        "Widgets"
      ]
    },
    "features": {
      "disable": [
        "XpsViewer",
        "PrintingXPS",
        "Smb1",
        "WorkFolders",
        "FaxAndScan"
      ]
    },
    "drivers": {
      "enabled": false,
      "directory": "C:\\XboxOS\\Drivers"
    },
    "updates": {
      "enabled": false,
      "directory": "C:\\XboxOS\\Updates"
    },
    "setup": {
      "unattend": true,
      "uiLanguage": "en-US",
      "inputLocale": "en-US",
      "systemLocale": "en-US",
      "userLocale": "en-US",
      "timeZone": "Pacific Standard Time",
      "hideEula": true,
      "privacy": "Minimal",
      "startupToGamingHome": false,
      "postInstall": {
        "enabled": true,
        "gameMode": true,
        "hardwareAcceleratedGpuScheduling": false,
        "launchers": [
          "Steam"
        ],
        "optimizations": [
          "WindowedGameOptimizations",
          "BackgroundRecordingOff"
        ]
      }
    },
    "output": {
      "directory": "C:\\XboxOS\\Output",
      "isoLabel": "XboxOS11"
    },
    "capabilities": {
      "remove": [
        "StepsRecorder",
        "MathRecognizer",
        "InternetExplorerMode",
        "PowerShellISE",
        "WordPad",
        "FaxScan",
        "QuickAssistLegacy",
        "ExtendedWallpapers"
      ]
    },
    "image": {
      "componentCleanup": true,
      "resetBase": true,
      "compression": "Recovery",
      "tweaks": [
        "NoSponsoredApps",
        "NoTipsAndSuggestions",
        "CleanTaskbar",
        "NoOneDriveForNewAccounts",
        "EdgeNoFirstRun"
      ]
    }
  }
}
