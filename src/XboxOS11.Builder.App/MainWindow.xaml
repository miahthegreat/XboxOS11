<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XboxOS11.Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XboxOS11.Builder.App.Views"
    Title="XboxOS11 Builder">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/XboxOS11.png" Width="20" Height="20" />
                <TextBlock Text="XboxOS11 Builder" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.ProfileFileName, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="•" Visibility="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            SelectionChanged="Nav_SelectionChanged"
            IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="1. Source" Tag="source" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE958;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="2. Preset" Tag="preset">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="3. Components" Tag="components">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="4. Drivers &amp; setup" Tag="setup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="5. Validate &amp; build" Tag="build">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Open profile…" Tag="open" SelectsOnInvoked="False" Tapped="OpenProfile_Tapped">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8E5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Save profile…" Tag="save" SelectsOnInvoked="False" Tapped="SaveProfile_Tapped">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
                <Grid Padding="32,24,32,32" MaxWidth="1040" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8" Margin="0,0,0,16">
                        <InfoBar Severity="Error" Title="Something went wrong" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False">
                            <InfoBar.ActionButton>
                                <Button Content="Dismiss" Command="{x:Bind ViewModel.DismissErrorCommand}" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Name="ElevationBar" Severity="Informational" IsClosable="True"
                                 Title="Administrator rights needed to build"
                                 Message="You can configure, validate, and dry-run now. Reading ISO editions and building a real ISO require running as administrator.">
                            <InfoBar.ActionButton>
                                <Button Content="Restart as administrator" Click="RestartElevated_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                    <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" />
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="16,6" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="14" Height="14" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.BackendDescription, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </Grid>
    </Grid>
</Window>
