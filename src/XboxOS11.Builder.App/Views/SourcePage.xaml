<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XboxOS11.Builder.App.Views.SourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:XboxOS11.Builder.Core.Models">

    <StackPanel Spacing="12">
        <TextBlock Text="Windows 11 source" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Style="{StaticResource PageSubtitleStyle}"
                   Text="Choose an official Windows 11 ISO from Microsoft. XboxOS11 never modifies the original file: it works on a copy in C:\XboxOS\Work and writes the new ISO to your output folder." />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Installation ISO" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="C:\ISOs\Win11_x64.iso" Text="{x:Bind ViewModel.IsoPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseIso_Click" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{x:Bind ViewModel.ReadEditionsCommand}" AutomationProperties.Name="Read editions">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="Read editions" />
                        </StackPanel>
                    </Button>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Mounts the ISO read-only (administrator required)." />
                </StackPanel>
                <ComboBox Header="Edition" MinWidth="360" ItemsSource="{x:Bind ViewModel.Editions}"
                          SelectedItem="{x:Bind ViewModel.SelectedEdition, Mode=TwoWay}" PlaceholderText="Read editions to choose one">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageEdition">
                            <TextBlock>
                                <Run Text="{x:Bind Name}" /><Run Text="  ·  index " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind Index}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Header="Edition match" Width="360" HorizontalAlignment="Left"
                         Text="{x:Bind ViewModel.EditionPattern, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTipService.ToolTip="Exact edition name, or a wildcard such as *Pro*. XboxOS11 is validated on Windows 11 Pro." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Profile and output" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox Header="Profile name" Width="480" HorizontalAlignment="Left"
                         Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind ViewModel.ProfileNameError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Output folder (not OneDrive, not the XboxOS11 folder)"
                             Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseOutput_Click" />
                </Grid>
                <TextBox Header="ISO volume label" Width="240" HorizontalAlignment="Left"
                         Text="{x:Bind ViewModel.IsoLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind ViewModel.IsoLabelError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind HasRecent}">
            <StackPanel Spacing="8">
                <TextBlock Text="Recent profiles" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <HyperlinkButton Content="{x:Bind}" Tag="{x:Bind}" Click="Recent_Click" Padding="4,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource AccentButtonStyle}" Content="Next: choose a preset" Click="Next_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
