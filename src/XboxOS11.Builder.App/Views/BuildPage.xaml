<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XboxOS11.Builder.App.Views.BuildPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:XboxOS11.Builder.App.ViewModels">

    <StackPanel Spacing="12">
        <TextBlock Text="Validate and build" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Style="{StaticResource PageSubtitleStyle}"
                   Text="Validation checks the profile against the protected-component list and your files. A dry run walks every phase without mounting or changing anything. A real build needs administrator rights, Windows ADK Deployment Tools, and about 40 GB of free space." />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PresetLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.IsoPath, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{x:Bind ViewModel.ValidateCommand}" Content="Validate" />
            <CheckBox Content="Dry run (no changes)" IsChecked="{x:Bind ViewModel.DryRun, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsNotBuilding, Mode=OneWay}" />
            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartBuildCommand}" AutomationProperties.Name="Start build">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Start" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.CancelBuildCommand}" Content="Cancel" />
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.ValidationErrors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Message="{x:Bind}" Margin="0,0,0,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{x:Bind ViewModel.ValidationWarnings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{x:Bind}" Margin="0,0,0,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{x:Bind ViewModel.BuildProgress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"
                                 AutomationProperties.Name="Build progress" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BuildProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Phases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhaseItem">
                            <Grid ColumnSpacing="10" Padding="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <InfoBar IsOpen="{x:Bind ViewModel.HasBuildResult, Mode=OneWay}" IsClosable="False" Title="Result"
                 Message="{x:Bind ViewModel.BuildResult, Mode=OneWay}" Severity="{x:Bind ResultSeverity, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Open output folder" Command="{x:Bind ViewModel.OpenOutputFolderCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Expander Header="Build log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <ListView x:Name="LogList" ItemsSource="{x:Bind ViewModel.LogLines}" MaxHeight="360" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <HyperlinkButton Content="Open log folder (C:\XboxOS\Logs)" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
