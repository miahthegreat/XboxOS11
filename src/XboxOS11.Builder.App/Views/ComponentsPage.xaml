<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XboxOS11.Builder.App.Views.ComponentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:XboxOS11.Builder.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="ComponentTemplate" x:DataType="vm:ComponentItem">
            <Grid Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled}" MinWidth="0" VerticalAlignment="Top"
                          AutomationProperties.Name="{x:Bind Title}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ProtectionText}" Visibility="{x:Bind IsProtected}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <FontIcon Grid.Column="2" Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind IsProtected}" ToolTipService.ToolTip="Protected" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <TextBlock Text="Review components" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Style="{StaticResource PageSubtitleStyle}"
                   Text="Checked items are removed or disabled in the new image. Locked items are dependencies of the Store, Xbox, or gaming services and can't be selected. Feature payloads are kept, so features can be re-enabled later." />

        <InfoBar IsOpen="True" IsClosable="False" Severity="Success" Title="Always preserved">
            <InfoBar.Content>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AlwaysPreserved}" Margin="0,0,0,12">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="190" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </InfoBar.Content>
        </InfoBar>

        <TextBlock Text="Apps to remove" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource CardStyle}" Padding="4">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Apps}" ItemTemplate="{StaticResource ComponentTemplate}" />
        </Border>

        <TextBlock Text="Optional features to disable" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource CardStyle}" Padding="4">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Features}" ItemTemplate="{StaticResource ComponentTemplate}" />
        </Border>

        <TextBlock Text="Optional Windows capabilities to remove" Style="{StaticResource SectionHeaderStyle}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="Removed capabilities can be added back later from Settings > System > Optional features (requires Windows Update)." />
        <Border Style="{StaticResource CardStyle}" Padding="4">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Capabilities}" ItemTemplate="{StaticResource ComponentTemplate}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Back" Click="Back_Click" />
            <Button Style="{StaticResource AccentButtonStyle}" Content="Next: drivers &amp; setup" Click="Next_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
